                ]
              },
              "types": {
                "items": {
                  "enum": [
                    "source_revision",
                    "citation",
                    "input",
                    "wait",
                    "proposal",
                    "action",
                    "artifact",
                    "outcome"
                  ],
                  "type": "string"
