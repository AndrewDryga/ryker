table inet ryker_worker {
  set controller_networks {
    type ipv4_addr
    flags interval
    auto-merge
    elements = $controller_networks
  }
  chain protected_destinations {
    ip daddr 172.30.42.10 tcp dport 4322 return
    ip daddr 0.250.250.200 udp dport 53 return
    ip daddr 0.250.250.200 tcp dport 53 return
    ip daddr @controller_networks counter reject with icmpx type admin-prohibited
    ip daddr { 192.168.139.0/24, 0.250.250.0/24, 127.0.0.0/8, 169.254.0.0/16 } counter reject with icmpx type admin-prohibited
    meta nfproto ipv6 counter reject with icmpx type admin-prohibited
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    jump protected_destinations
  }
  chain output {
    type filter hook output priority -10; policy accept;
    oifname "lo" accept
    ct direction reply accept
    jump protected_destinations
  }
  chain input {
    type filter hook input priority -10; policy accept;
    ct state established,related accept
    iifname { "lo", "eth0" } accept
    ip daddr $guest_ipv4 udp dport 53 accept
    ip daddr $guest_ipv4 tcp dport 53 accept
    counter reject with icmpx type admin-prohibited
  }
}
