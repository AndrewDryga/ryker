[Unit]
Description=Emisar Responder teammate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=responder
Group=responder
UMask=0077
StateDirectory=responder
StateDirectoryMode=0700
EnvironmentFile=/etc/responder/responder.env
Environment=RESPONDER_ELIXIR_CONFIG=/etc/responder/responder-elixir.yaml
Environment=RELEASE_DISTRIBUTION=none
Environment=RELEASE_TMP=/var/lib/responder/tmp
WorkingDirectory=/var/lib/responder
ExecStartPre=/usr/local/lib/responder/current/bin/responder eval Responder.Release.migrate()
ExecStart=/usr/local/lib/responder/current/bin/responder start
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/responder
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
