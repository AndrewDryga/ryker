# Owner-only environment for the Elixir/PostgreSQL service. Replace every value
# before start. This file carries deployment connections and credentials only:
# product settings live in PostgreSQL and are changed through the console.
DATABASE_URL=ecto://responder:replace-me@127.0.0.1/responder
POOL_SIZE=20

# Base64 for exactly 32 random bytes. It encrypts durable remote-work
# checkpoints. Import the existing value on an upgrade; a new key orphans every
# stored workspace checkpoint.
RESPONDER_CHECKPOINT_KEY=replace-with-base64-32-byte-key
RESPONDER_STATE_TOOLS_TOKEN=replace-with-state-tools-root-secret

# Credentials for the integrations enabled in settings. A credential present
# here never enables an integration by itself.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
EMISAR_API_TOKEN=replace-with-emisar-api-token

GITHUB_APP_ID=replace-with-github-app-id
# Single-line base64 of the complete App private-key PEM. Raw PEM remains valid
# for secret providers that can carry newlines, but systemd EnvironmentFile cannot.
GITHUB_APP_PRIVATE_KEY=replace-with-base64-encoded-github-app-private-key-pem
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

# Outbound worker gateway. Supply all five or none.
RESPONDER_WORKER_PUBLIC_URL=https://responder.example.com:4322
RESPONDER_WORKER_CA_FILE=/etc/responder/worker-ca.pem
RESPONDER_WORKER_CA_KEY_FILE=/etc/responder/worker-ca-key.pem
RESPONDER_WORKER_CERT_FILE=/etc/responder/worker-gateway.pem
RESPONDER_WORKER_KEY_FILE=/etc/responder/worker-gateway-key.pem

# Custom webhook sources may only reference a credential registered here.
RESPONDER_WEBHOOK_SECRET_NAMES=ALERTS_SIGNING_KEY
ALERTS_SIGNING_KEY=replace-with-universal-webhook-secret

# Optional, all with shipped defaults:
# RESPONDER_CONTROL_IP, RESPONDER_CONTROL_PORT, RESPONDER_STATE_DIR,
# RESPONDER_STATE_TOOLS_IP, RESPONDER_STATE_TOOLS_PORT,
# RESPONDER_WORKER_IP, RESPONDER_WORKER_PORT,
# RESPONDER_GITHUB_IP, RESPONDER_GITHUB_PORT,
# RESPONDER_WEBHOOK_IP, RESPONDER_WEBHOOK_PORT,
# GITHUB_API_URL, EMISAR_RPC_URL, LOG_LEVEL.
