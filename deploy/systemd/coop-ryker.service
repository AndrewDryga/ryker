[Unit]
Description=Coop session controller for Ryker
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ryker
Group=ryker
SupplementaryGroups=docker
UMask=0077
StateDirectory=ryker
StateDirectoryMode=0700
Environment=COOP_CONFIG_DIR=/var/lib/ryker/coop/agents
ExecStart=/usr/local/bin/coop sessions serve --state /var/lib/ryker/coop --policies /etc/ryker/session-policies.yaml --socket /var/lib/ryker/coop/control.sock
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ryker /srv/repos
LockPersonality=true

[Install]
WantedBy=multi-user.target
